# ===== 必須（無料構成はこの2つだけ） =====
# 社内共通パスワード（ログイン画面で入力）
APP_PASSWORD=change-me

# Gemini API キー（Google AI Studio https://aistudio.google.com/ → Get API key。無料枠・カード不要）
# プロンプト生成（gemini-2.5-flash）と画像生成（gemini-2.5-flash-image）の両方に使う
GEMINI_API_KEY=

# ===== 任意：精度を上げたい時に追加（従量課金） =====
# OpenAI gpt-image-1 で画像生成する場合（設定すると IMAGE_PROVIDER=openai で切替可）
OPENAI_API_KEY=
# Claude でプロンプト生成する場合（設定すると PROMPT_PROVIDER=anthropic で切替可）
ANTHROPIC_API_KEY=

# ===== 任意（省略時はデフォルト） =====
# PROMPT_PROVIDER=gemini      # gemini | anthropic（未設定: Geminiキーがあれば gemini）
# IMAGE_PROVIDER=gemini       # gemini | openai  （未設定: Geminiキーがあれば gemini）
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_PAID_TIER=1          # Gemini を有料枠に切替えたら 1（画面の「無料枠」表示が消える）
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_IMAGE_MODEL=gpt-image-1
# MAX_IMAGES_PER_REQUEST=3    # 1回の生成で許可する最大枚数
