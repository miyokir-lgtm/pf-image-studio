# ===== 必須 =====
# 社内共通パスワード（ログイン画面で入力）
APP_PASSWORD=change-me

# OpenAI APIキー（画像生成）
# https://platform.openai.com/ → 組織の本人確認 → Billing で $5 前払い → API keys で発行
OPENAI_API_KEY=

# ===== 推奨（明示しておくと切替事故が起きない） =====
# 画像エンジン: openai / gemini / demo（demo=キーを残したままプレースホルダ表示でプレビュー）
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2

# ===== 任意 =====
# 1回の生成で許可する最大枚数（コスト上限の保険）
MAX_IMAGES_PER_REQUEST=3

# 画像エンジンを Gemini に戻す場合のみ（IMAGE_PROVIDER=gemini と併用）
# ※ 2026年8月以降、Gemini の画像モデルは無料枠が 0 で有料枠が必須です
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# プロンプト生成はテンプレート方式（content/*.json）のため、
# ANTHROPIC_API_KEY / GEMINI テキストモデルは不要です。
